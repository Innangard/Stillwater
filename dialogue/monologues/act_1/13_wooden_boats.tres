[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Journal Scrap"
text = "I carve wooden boats from the driftwood I find along the southern coast, though there is no wind to sail them. I line them up on the sand, hundreds of them, pointing toward a horizon that never changes. It is a foolish task, but counting the boats reminds me that I have survived another year without losing my mind."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
