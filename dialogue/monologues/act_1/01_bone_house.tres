[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Carving"
text = "We step onto this shore having left our bone-house behind in the dirt of the living world, yet we still feel the bitter cold of the sea wind. It bites at flesh that is no longer there, a phantom ache that never truly fades. You will look down at your hands and see the shape of them, but the substance has fundamentally changed into something heavy and dark."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
