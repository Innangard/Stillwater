[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "An Overheard Voice"
text = "For a warrior, this place is a quiet humiliation. There is no glory in striking down a shade that will simply reform at the arch tomorrow. We swing our swords out of boredom, pantomiming the great battles of our youth in a land where death has lost all of its teeth."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
