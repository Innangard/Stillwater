[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Journal Scrap"
text = "I died of a wasting sickness when I was twenty, my body wracked with pain and rot. Here, my lungs are clear, my limbs are strong, and I will never age another day. The others weep for the world they lost, but I pray the water never calls my name. I want to remain exactly as I am."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
