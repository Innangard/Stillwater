[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Carving"
text = "The third weaver is gone. Because there is no tomorrow left to weave, she has fled into the dark to hide. Her sisters sit weeping in their workshops, tending to a past and present that lead nowhere. Until the King falls, the loom of the future remains violently still."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
