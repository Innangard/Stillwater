[ext_resource type="Script" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Carving"
text = "I walked into the western marshes today just to feel the mud pull at my boots. It is a dirty, foul-smelling place, but the stench of sulfur and rot is the closest thing to reality I can find. The pristine, sterile ash of the safe paths was driving me completely mad."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
