[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Carving"
text = "The corpse-sea in the center is dammed by the King\'s decree. It only ripples against the stone. Nothing leaves through it, and so the great cycle of the cosmos is entirely broken. The souls gather at the shores, staring at the still surface, knowing we cannot go home."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
