[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Carving"
text = "They say the King built his tower out of fear, but I understand him. Why should we surrender the minds we cultivated, the skills we honed, just to be wiped clean like slate? The King is the only one who realized that eternity does not have to be an erasure."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
