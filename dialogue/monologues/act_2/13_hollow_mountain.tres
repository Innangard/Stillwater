[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Carving"
text = "I sought out the giant in the hollow mountain just to see something massive, something awe-inspiring. He nearly crushed me with a boulder. It hurt terribly, but as my body dissolved into ash and sent me back to the arch, I smiled. It was the most exciting thing to happen to me in eighty years."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
