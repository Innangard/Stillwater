[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Carving"
text = "We gather near the western tree to watch the leaves turn brown and fall to the earth. It is the only thing on this entire island that changes. We treat every dropping leaf as a sacred event, a reminder that time is still passing somewhere, even if it has stopped for us."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
