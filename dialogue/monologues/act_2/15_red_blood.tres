[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Carving"
text = "I saw the living stranger bleed today. The liquid was thick, bright crimson, and it stained the stone where it fell. A feral shade tried to lick it from the ground, whimpering like a starved dog. The sight of red blood in this world is a terrifying, beautiful omen."

