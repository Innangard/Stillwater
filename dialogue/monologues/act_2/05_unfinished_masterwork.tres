[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Carving"
text = "He never finished his masterwork. Deep in the abandoned western forge, he hammers still, shaping a wound-hoe he will never swing in life. He was an apprentice to the greatest of dwarven smiths, and he refused the water because the metal was still hot. Now, the lava has fused with his cracking armor."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
