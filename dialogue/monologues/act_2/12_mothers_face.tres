[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Carving"
text = "I cannot remember the face of my mother. I try to draw her features in the dirt, but the lines always blur into the face of the feral beasts roaming the edge of the camp. Memory is a sieve, and the longer we wait, the wider the holes become."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
