[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Carving"
text = "The ash-weeper guards the Brann volcano, a queen of embers who burns all who dare approach her static reign. Like the Tyrant King, she claimed a domain to rule, hoarding the heat of the far western tip. She stands amid the pyres, scorching the flesh of any pilgrim trying to find the arches."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
