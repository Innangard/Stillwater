[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Carving"
text = "The sky-candle does not move here. It is a long, grey afternoon that never ends, and we are so very tired of waiting. In the living world, the sun chased the moon, and the seasons turned. Here, the light simply hangs, mocking us with an eternity of twilight."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
