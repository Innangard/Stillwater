[ext_resource type="Script" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "A Carving"
text = "My husband arrived at the West arch a century after I did. We wept, holding each other, swearing we would never be parted again. But yesterday, the Pool called his name, and he walked into the water to be unmade. I am alone again, terrified that my turn will never come."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1")])
