[gd_resource type="Resource" script_class="Dialogue" format=3 uid="uid://cn6mxvdgd61py"]

[ext_resource type="Script" uid="uid://20vxx3lmqysn" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" uid="uid://cpen105j75gae" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Fortune-teller Ylla"
text = "The sea speaks in runes, if you listen. Salt patterns on the dock planks. Frost on the hull rivets. The reading of small things is most of the trade."

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Fortune-teller Ylla"
text = "I am no Norn — let me say it plainly, before you ask. My grandmother claimed she was, and her mother claimed she taught the Norns themselves. Souls tell stories on this island. The work is real. The bloodline is not."

[sub_resource type="Resource" id="line3"]
script = ExtResource("2")
speaker = "Fortune-teller Ylla"
text = "Bring me bone or stone and I will bind a rune to it. Mind the salt marshes south of here — the old wreck has been moaning at low tide. I do not like the sound it makes."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line1"), SubResource("line2"), SubResource("line3")])
