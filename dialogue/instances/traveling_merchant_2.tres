[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Traveler"
text = "Not many pilgrims make it this far. Take a look at what I've got before the forest reclaims us both."

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Traveler"
text = "Every item has a story. I don't tell them for free, but I sell the items cheap."

