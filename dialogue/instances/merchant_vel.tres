[gd_resource type="Resource" script_class="Dialogue" format=3 uid="uid://gb8lsqffuuqk"]

[ext_resource type="Script" uid="uid://20vxx3lmqysn" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" uid="uid://cpen105j75gae" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "Merchant Vel"
text = "A pulse, not just a memory of one. Welcome to my stall."

[sub_resource type="Resource" id="line_2"]
script = ExtResource("2")
speaker = "Vel"
text = "Souls is what we use here. Always have. Easier than carrying anything heavier — the dead don't like weight much. You'll find them on whatever the cold ones leave behind. And they leave a lot, given the time."

[sub_resource type="Resource" id="line_3"]
script = ExtResource("2")
speaker = "Vel"
text = "Take your time. Look around. I'll keep my prices honest. Mostly."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line_1"), SubResource("line_2"), SubResource("line_3")])
