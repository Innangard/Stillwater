[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" uid="uid://20vxx3lmqysn" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" uid="uid://cpen105j75gae" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Bjorn"
text = "On clear days you can see the bridge from here. It stretches south across the water, stone on stone, and at the far end, the Tower. There is a figure on the bridge. It does not move. It has not moved in the five hundred years we have been watching."

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Bjorn"
text = "We call it the herald. We do not know its name. We do not cross the bridge to ask."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line1"), SubResource("line2")])
