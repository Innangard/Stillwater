[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" uid="uid://20vxx3lmqysn" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" uid="uid://cpen105j75gae" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Bark-speaker Revna"
text = "Every tree remembers. They grew from seeds that fell before the first people walked here, and they will stand long after the last of us is gone."

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Bark-speaker Revna"
text = "The runes I carve come from heartwood. A living tree gives its core willingly when asked in the old way. I do not cut, I listen."

[sub_resource type="Resource" id="line3"]
script = ExtResource("2")
speaker = "Bark-speaker Revna"
text = "Something deep in the forest is angry. The roots are pulling toward it. If you go further, watch where the moss points."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line1"), SubResource("line2"), SubResource("line3")])
