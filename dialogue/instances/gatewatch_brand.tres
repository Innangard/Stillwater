[sub_resource type="Resource" id="line_1"]
script = ExtResource("2")
speaker = "Gatewatch Brand"
text = "Pilgrim. Nasus is closed past the gate house for now. The king's men are 'relaying foundations,' or so the order reads. Come back when the masons have rested. I do not expect that to be soon."

