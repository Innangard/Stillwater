[ext_resource type="Script" uid="uid://cpen105j75gae" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Lira"
text = "The plaza's open, but the good stock is inside the gate. What I've got is what filtered through the bars before they sealed them."

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Lira"
text = "Still better than anything you'll find in the mud. Browse if you like."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line1"), SubResource("line2")])
