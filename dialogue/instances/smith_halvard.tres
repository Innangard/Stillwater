[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Halvard"
text = "The ash gets into everything. The metal, the leather, the water. I forge through a cloth mask and the sparks land in grey powder and vanish. The weapons come out pale. They work fine. They just look like they have already been used."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line1")])
