[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Vigdis"
text = "No nails. Nails crack. Everything here is lashed, pegged, and wedged. You bring me metal and I will work it, but I will not promise it holds in the cold. The cold breaks promises."

