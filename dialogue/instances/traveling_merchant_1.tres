[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Traveler"
text = "The road provides, if you know where to look. I've collected more than I can carry — care to trade?"

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Traveler"
text = "Take your time. I'm in no rush — the wolves don't come here."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line1"), SubResource("line2")])
