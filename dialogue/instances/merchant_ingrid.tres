[ext_resource type="Script" uid="uid://cpen105j75gae" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Ingrid"
text = "I keep the supply chain alive. When the pass closes, Frostgard eats what I have stockpiled and nothing else."

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Ingrid"
text = "Prices go up in winter. That is not greed, that is the weight of carrying provisions through waist-deep snow. Take what you need before the season turns."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line1"), SubResource("line2")])
