[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" uid="uid://20vxx3lmqysn" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" uid="uid://cpen105j75gae" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Sigrid"
text = "I built these walls. Every stone, I placed or approved. My name is Sigrid and I was a jarl's architect before I died, and I spent a hundred years drawing this fortress in the dirt before anyone would help me lift a block."

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Sigrid"
text = "The forge came last. I built it into the south wall so the heat would radiate inward. You want a weapon, I will make you one. But look at the walls first. The walls are the real work."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line1"), SubResource("line2")])
