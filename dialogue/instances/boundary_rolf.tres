[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Rolf"
text = "I walk the perimeter. Every day, out to the stones and back. The stones have not moved. The directions have not changed. The things in the desert have not come closer. But I check, because the day I do not check is the day something changes."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line1")])
