[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" uid="uid://20vxx3lmqysn" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" uid="uid://cpen105j75gae" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Eirik"
text = "I watch the tides. Every morning there is new wood on the beach, grey and salt-crusted, and every morning I count the pieces. The number changes but the wood is always the same kind. Pine. Old pine. From somewhere that has forests."

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Eirik"
text = "There are no forests where this water comes from. I have been watching for two hundred years and I still do not know where the wood originates. I have stopped asking. The tide does not answer questions."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line1"), SubResource("line2")])
