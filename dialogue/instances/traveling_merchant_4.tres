[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Traveler"
text = "I don't stay anywhere long. What I have now is what I have. Next time I pass through, it'll be different stock."

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Traveler"
text = "Souls for goods, goods for survival. Simple math."

