[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" uid="uid://20vxx3lmqysn" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" uid="uid://cpen105j75gae" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Saga"
text = "The standing stones at the edge of the settlement carry directions carved by the first inhabitants. Which way is safe. Which way is not. I maintain the stones. I update them when the dangers shift."

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Saga"
text = "The runes I inscribe are practical. Protection, endurance, clarity. The kind of inscriptions you want on your gear before you walk into the place the stones warn you about."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line1"), SubResource("line2")])
