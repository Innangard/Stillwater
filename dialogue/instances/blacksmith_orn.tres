[ext_resource type="Script" uid="uid://20vxx3lmqysn" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" uid="uid://cpen105j75gae" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Orn"
text = "Nasus iron. Proper iron. Not the bog-stained junk they hammer in the villages."

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Orn"
text = "The king's masons sealed the inner foundry, said the fires were 'unworthy of the new order.' Left me the outer forge because someone has to mend the cooking pots. I can still do real work. Show me what you've got."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line1"), SubResource("line2")])
