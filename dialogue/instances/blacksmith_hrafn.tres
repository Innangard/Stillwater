[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" uid="uid://20vxx3lmqysn" path="res://dialogue/dialogue.gd" id="1"]
[ext_resource type="Script" uid="uid://cpen105j75gae" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Hrafn"
text = "The driftwood brings iron sometimes. Nails, hinges, things from ships that never were. I pull them from the wood and hammer them flat. It is not proper smithing. But it is what the tide provides."

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Hrafn"
text = "You want something forged, I will forge it. But do not ask where the metal came from. I do not know, and the not-knowing has stopped bothering me."

[resource]
script = ExtResource("1")
lines = Array[ExtResource("2")]([SubResource("line1"), SubResource("line2")])
