[ext_resource type="Script" uid="uid://cpen105j75gae" path="res://dialogue/dialogue_line.gd" id="2"]

[sub_resource type="Resource" id="line1"]
script = ExtResource("2")
speaker = "Traveler"
text = "Found these in a ruin two days' walk south. No use to me, but you look like you could put them to work."

[sub_resource type="Resource" id="line2"]
script = ExtResource("2")
speaker = "Traveler"
text = "The Norns say trade is a form of prayer. I'm very devout."

[resource]
