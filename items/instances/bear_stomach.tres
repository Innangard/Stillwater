[resource]
script = ExtResource("1")
item_name = "Bear Stomach"
description = "The bear's stomach lining, taken whole. The wall is unnaturally thick — bears that eat the burnt and the smoking grow flesh that won't burn. Tanned correctly, it lines armor against heat better than any forge-finish. Reagent."
category = "reagent"
placeholder_color = Color(0.50, 0.32, 0.22, 1)
