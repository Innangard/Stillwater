[gd_resource type="Resource" script_class="Item" format=3]

[ext_resource type="Script" path="res://items/item.gd" id="1"]

[resource]
script = ExtResource("1")
item_name = "Heartcoal"
description = "A single coal pulled from the bottom of a kiln that was never lit — burning anyway, and has been since the world was new. Burns without smoke, without ash, without ever growing smaller. Reckoned the truest fire on Jörmund. Reagent."
category = "reagent"
placeholder_color = Color(1.00, 0.32, 0.10, 1)
