[gd_resource type="Resource" script_class="Item" format=3]

[ext_resource type="Script" path="res://items/item.gd" id="1"]

[resource]
script = ExtResource("1")
item_name = "Hoarfrost Tear"
description = "A teardrop crystal grown in the heart of bog-ice that refuses the spring. Holds cold the way a vow holds a king. Reckoned the rarest reagent of the moor — fit only for edges that need to remember themselves through fire. Reagent."
category = "reagent"
placeholder_color = Color(0.70, 0.85, 0.95, 1)
