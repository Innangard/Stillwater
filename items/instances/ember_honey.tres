[ext_resource type="Script" path="res://items/item.gd" id="1"]

[resource]
script = ExtResource("1")
item_name = "Ember-Honey"
description = "A viscous, near-luminous honey rendered by the fire-bees that nest in the volcanic vents below Brann. Sweet on the tongue, but the burn comes second. Used as a hardening varnish on weapons that need to keep the heat in. Reagent."
category = "reagent"
placeholder_color = Color(0.95, 0.55, 0.18, 1)
