[gd_resource type="Resource" script_class="ConsumableItem" format=3]

[ext_resource type="Script" path="res://items/consumable_item.gd" id="1"]

[resource]
script = ExtResource("1")
item_name = "Pyre Salve"
description = "A burning ointment in a small clay jar — beeswax, ghost-lichen, and a drop of living fire. The burn drives out everything else. Apply it and whatever's eating you stops eating, at least for a while. Clears all curses, burns, poisons, and other afflictions. Consumable."
category = "consumable"
max_stack = 3
placeholder_color = Color(0.95, 0.55, 0.30, 1)
heal_amount = 0.0
grants_status = null
clears_hostile_statuses = true
