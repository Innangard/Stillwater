[resource]
script = ExtResource("1")
item_name = "Mountain Marrow"
description = "A thick paste rendered from the bones of mountain goats, mixed with honey and ground feldspar. Your arms remember what stone was. Damage dealt increased 15% for 25 seconds — but the marrow hardens everything, including your ability to take a hit. Incoming damage increased 10%. Consumable."
category = "consumable"
max_stack = 5
placeholder_color = Color(0.70, 0.65, 0.55, 1)
heal_amount = 0.0
