[resource]
script = ExtResource("1")
recipe_name = "Forge Wormgold Falchion"
description = "Wrap the grip in wormgold wire, work gravewax into the hilt-bedding. The blade comes out heavier than it was, somehow. Refuses, at first, to be sheathed."
