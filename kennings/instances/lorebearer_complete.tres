[resource]
script = ExtResource("1")
kenning_id = "lorebearer_complete"
display_name = "Long-Memoried"
epithet = "She who carries every voice the shore has spoken"
description = "You have read every carving on Jörmund — every warning, every prayer, every small confession scratched into stone by the souls who came before you. Their accumulated weight is yours now, and the island knows your step."
flavor_text = "I am no longer a person. I am not a monster yet. I am only a vessel for what the shore remembers."
category = 4
unlock_flag = "all_monologues_read_total"
unlock_hint = "Read every carving on the long shore."
damage_dealt_multiplier = 1.10
damage_taken_multiplier = 0.90
move_speed_multiplier = 1.05
max_health_bonus = 20.0
tier_color = Color(0.90, 0.85, 0.65, 1)
