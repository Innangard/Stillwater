script = ExtResource("scene_intro_script")
intro_lore_text = "Before the world, there was the gap.

Cold met heat across it, and life leaked through.

You come through now, chosen.

You carry no name yet.

Walk on."
intro_flag = "ginnungagap_intro_played"

