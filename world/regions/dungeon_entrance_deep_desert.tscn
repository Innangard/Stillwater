; ExitWest — runtime-rewritten by _try_chain to point at the deep
; desert corridor's last buffer. Static fallback is the sundust altar
; so a player isn't stranded if override logic ever fails.
[node name="ExitWest" parent="." instance=ExtResource("exit_scene")]
position = Vector2(-480, 0)
target_scene = "res://world/regions/sundust_altar.tscn"
target_spawn_point = "from_east"
label = "←  back into the desert"
tint = Color(0.58, 0.50, 0.36, 0.4)
zone_size = Vector2(48, 192)

; ExitEast — the dungeon proper. Static wire (the dungeon is a
; standalone scene, not part of any randomized chain), goes to the
; placeholder boss arena. When the optional boss content lands, this
; exit stays valid; only the arena scene itself gets populated.
[node name="ExitEast" parent="." instance=ExtResource("exit_scene")]
