[node name="DungeonEntranceDeepDesert" type="Node2D" unique_id=2200000001]
script = ExtResource("region_script")
region_id = "dungeon_entrance_deep_desert"
player_scene = ExtResource("player_scene")

; Deep Desert dungeon entrance. The threshold sits at the eastern end
; of a long NE corridor from the Sundust Altar — the player has fought
; through twenty rooms of worms, husks, and scorpions to arrive here.
; The visual language is heavier and more ominous than the Sundust
; Gate: cracked stone steps descending into darkness, vitrified glass
; shards from worm activity, sun-bleached bones piled at the corners.
;
; Currently empty by design. The dungeon proper (linked via ExitEast)
; is a single empty boss arena waiting for the optional boss to be
; designed. The player can walk in, look around, walk out. When the
; boss content lands, the arena scene gets populated and the player
; comes back here knowing what waits inside.

