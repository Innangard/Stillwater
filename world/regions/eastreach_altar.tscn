[node name="Player" parent="." unique_id=1200000025 instance=ExtResource("player_scene")]
position = Vector2(0, 240)

; Guardian enemies — a different combo from Westmoor's
; (skeleton_pillar + skeleton_fan) so the fight feels distinct:
; one big static threat plus one fast melee chaser. Difficulty
; comparable to Westmoor's altar, not strictly harder.
[node name="GuardianPillar" parent="." unique_id=1200000026 instance=ExtResource("enemy_a")]
position = Vector2(-150, -100)

[node name="GuardianWolf" parent="." unique_id=1200000027 instance=ExtResource("enemy_b")]
position = Vector2(160, -90)

; Capstone loot. deep_gold_tablet is the high-prestige reward
; (reserved exclusively for this altar — doesn't appear elsewhere
; in the pool). Hearthbrand mirrors the Westmoor's Thunderstrike
; Spear slot as the altar's signature weapon.
[node name="DeepGoldTabletPickup" parent="." unique_id=1200000028 instance=ExtResource("pickup_scene")]
position = Vector2(0, 100)
item = ExtResource("loot_capstone")
persistent_per_run = true

