; Four cardinal exits. apply_overrides rewires whichever direction
; the chain's last buffer approaches from; the others remain as
; static fallbacks pointing back to nasus_overlook so the player
; can never get stranded if PathManager fails to wire correctly.
[node name="ExitSouth" parent="." instance=ExtResource("exit_scene")]
position = Vector2(0, 320)
target_scene = "res://world/regions/nasus_overlook.tscn"
target_spawn_point = "default"
label = "↓  back the way you came"
tint = Color(0.55, 0.48, 0.32, 0.4)
zone_size = Vector2(192, 48)

