; Single exit back the way you came. apply_overrides will rewire its
; target_scene + target_spawn_point at runtime based on which buffer
; the chain attached here from. The direction the exit lives on
; (south/east/west) doesn't matter for the rewire — _try_chain uses
; OPPOSITE[last.forward_exit_dir] to find the right Exit child. We
; provide all four cardinal exits so any approach direction works.
[node name="ExitSouth" parent="." unique_id=1100000031 instance=ExtResource("exit_scene")]
position = Vector2(0, 320)
target_scene = "res://world/regions/storsprunga_altar.tscn"
target_spawn_point = "from_north"
label = "↓  south to the coast"
tint = Color(0.42, 0.48, 0.52, 0.4)
zone_size = Vector2(192, 48)
zone_size = Vector2(192, 48)

[node name="ExitEast" parent="." unique_id=1100000033 instance=ExtResource("exit_scene")]
position = Vector2(360, 0)
target_scene = "res://world/regions/nasus_overlook.tscn"
target_spawn_point = "default"
label = "→  back the way you came"
tint = Color(0.40, 0.44, 0.46, 0.4)
zone_size = Vector2(48, 192)

[node name="ExitWest" parent="." unique_id=1100000034 instance=ExtResource("exit_scene")]
