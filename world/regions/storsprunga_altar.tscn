[node name="Player" parent="." unique_id=1500000070 instance=ExtResource("player_scene")]
position = Vector2(0, 260)

; Guardian — a lone draugr-touched coast-walker. Mid-tier guardian:
; the coast altar gates the connection between two regions, so its
; defender should feel like an inflection-point fight rather than a
; trivial obstacle. One wolf-pack tier enemy + one skeleton, mirroring
; the wickbarrow guardian density.
[node name="GuardianWolf" parent="." unique_id=1500000080 instance=ExtResource("enemy_a")]
position = Vector2(-140, -90)

[node name="GuardianSkeleton" parent="." unique_id=1500000081 instance=ExtResource("enemy_b")]
position = Vector2(140, -90)

; Loot. Two phials + a frost filament. Modest stash since this altar's
; main reward is the inter-region connection it provides, not the loot
; pile — the player gets a real gameplay benefit (skip Nasus to reach
; Westmoor) which is the actual capstone here.
[node name="SoulPhialPickupL" parent="." unique_id=1500000090 instance=ExtResource("pickup_scene")]
position = Vector2(-200, -150)
item = ExtResource("item_phial")
persistent_per_run = true

[node name="SoulPhialPickupR" parent="." unique_id=1500000091 instance=ExtResource("pickup_scene")]
position = Vector2(200, -150)
item = ExtResource("item_phial")
persistent_per_run = true

[node name="FrostFilamentPickup" parent="." unique_id=1500000092 instance=ExtResource("pickup_scene")]
position = Vector2(0, 100)
item = ExtResource("item_frost")
persistent_per_run = true

; ExitSouth — back into the coast chain toward Storsprunga. The
; runtime _try_chain rewrites this to point at the last buffer of the
; coast chain; static fallback is storsprunga_town directly so the
; player is never stranded if override logic fails.
[node name="ExitSouth" parent="." instance=ExtResource("exit_scene")]
position = Vector2(0, 320)
target_scene = "res://world/regions/storsprunga_town.tscn"
target_spawn_point = "from_north"
label = "↓  back along the coast"
tint = Color(0.40, 0.46, 0.50, 0.4)
zone_size = Vector2(192, 48)

; ExitNorth — the new connector toward Westmoor Altar. The runtime
; _try_chain rewrites this to point at the first buffer of the
; coast-to-west connector; static fallback is the westmoor altar
; directly so the connector is at least reachable even on a path
; manager hiccup.
[node name="ExitNorth" parent="." instance=ExtResource("exit_scene")]
position = Vector2(0, -320)
target_scene = "res://world/regions/westmoor_altar.tscn"
target_spawn_point = "from_south"
label = "↑  inland to the moor"
tint = Color(0.42, 0.48, 0.52, 0.4)
zone_size = Vector2(192, 48)

; ExitEast and ExitWest — unused. Coast region only connects north-
; south here. Fallback to Storsprunga so a player who somehow steps
; into them isn't stranded; they just round-trip back to the town
; below. No label nudge on these — the player should learn from
; trying them once that they don't lead anywhere new.

; Carving wired to the Act I pool, same as the other four shipped
; altars. Storsprunga's altar is the fifth carving in the world; future
; act-2 altars (when the western volcano region ships) should wire to
; act_2_pool instead.
[node name="AltarCarving" parent="." unique_id=1599999000 instance=ExtResource("carving_scene")]
position = Vector2(0, -36)
pool = ExtResource("monologue_pool")
carving_name = "Salt-Worn Stone"
carving_id = "storsprunga_main"
tint = Color(0.45, 0.45, 0.42, 1)
