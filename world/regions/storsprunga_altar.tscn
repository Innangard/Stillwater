player_scene = ExtResource("player_scene")

; Coast palette — kelp-and-stone. Reads as a sea shrine: cool stone
; floor under a pale-grey sky, kelp tide-line at the edges. Visually
; distinct from the four prior altars (Westmoor slate, Eastreach
; chalk, Wickbarrow forest, Sundust sand) so the player knows
; immediately which altar they're at. Coast = "the sea kept its dead
; here and the dead stayed beside the water."
[node name="Background" type="ColorRect" parent="." unique_id=1500000002]
offset_left = -2000.0
offset_top = -2000.0
offset_right = 2000.0
offset_bottom = 2000.0
mouse_filter = 2
color = Color(0.32, 0.36, 0.40, 1)

[node name="Clearing" type="ColorRect" parent="." unique_id=1500000003]
offset_left = -300.0
offset_top = -240.0
offset_right = 300.0
offset_bottom = 240.0
mouse_filter = 2
color = Color(0.48, 0.52, 0.56, 1)

; Tide-line bands at top and bottom — kelp-strand colored — give the
; altar a "low-tide flat" feel without us needing actual animated
; water. Visual continuity with the coast pool's seaweed-greens.
