; Spawn markers — one per cardinal direction. The sundust chain
; approaches from the south (chain walks NE from Eastreach altar, so
; the last buffer's forward exit is whichever cardinal the chain
; final-stretches in — south is most likely given the NE diagonal
; ending at this altar). _try_chain rewires whichever exit corresponds
; to the chain's approach direction; the other three are static
; fallbacks (set below) routing back to the altar's expected approach.
[node name="default" type="Marker2D" parent="." unique_id=1400000025]
position = Vector2(0, 240)

[node name="from_north" type="Marker2D" parent="." unique_id=1400000026]
position = Vector2(0, -240)

[node name="from_south" type="Marker2D" parent="." unique_id=1400000027]
position = Vector2(0, 240)

[node name="from_east" type="Marker2D" parent="." unique_id=1400000028]
position = Vector2(340, 0)

[node name="from_west" type="Marker2D" parent="." unique_id=1400000029]
position = Vector2(-340, 0)

[node name="Player" parent="." unique_id=1400000030 instance=ExtResource("player_scene")]
position = Vector2(0, 240)

; NO enemies, NO pickups. Per user request: content for this entire
; area (path rooms + altar) will be authored in a future pass. The
; altar exists as a structural endpoint anchoring the chain on the
; world map and giving the player a clear "you've reached the
; destination" room. Capstone loot + guardian fight slot in here
; later.

; Exits — static fallback targets all point at eastreach_altar.tscn.
; The runtime override (_try_chain on sundust_chain end-of-chain)
; will rewire whichever exit the chain approached from to point at
; the last sundust buffer instead. The other three exits keep these
; static targets, ensuring the player always has a way back even if
; something unexpected happens to the chain.

[node name="ExitEast" parent="." instance=ExtResource("exit_scene")]
position = Vector2(360, 0)
target_scene = "res://world/regions/dungeon_entrance_deep_desert.tscn"
target_spawn_point = "default"
label = "→  into the deep desert"
tint = Color(0.55, 0.42, 0.28, 0.4)
