[node name="SundustAltar" type="Node2D" unique_id=1400000001]
script = ExtResource("region_script")
region_id = "sundust_altar"
player_scene = ExtResource("player_scene")

; Desert palette — same warm sand as eastreach so the visual continuity
; tells the player "you're deeper in the same biome", not "you've
; crossed into something new". The dryness comes from the decor
; (sandstone obelisks, cracked earth, sun-bleached bone) rather than
; a palette shift. This is intentional — the climb NE is into THE
; SAME desert, only farther.
[node name="Background" type="ColorRect" parent="." unique_id=1400000002]
offset_left = -2000.0
offset_top = -2000.0
offset_right = 2000.0
offset_bottom = 2000.0
mouse_filter = 2
color = Color(0.55, 0.50, 0.40, 1)

[node name="Clearing" type="ColorRect" parent="." unique_id=1400000003]
offset_left = -300.0
offset_top = -240.0
offset_right = 300.0
offset_bottom = 240.0
mouse_filter = 2
color = Color(0.72, 0.62, 0.42, 1)

; Four sandstone obelisks at the cardinal points. Distinct silhouette
; from the other three altars:
;   Westmoor — slate slabs + flame triangle
;   Eastreach — bone-pale cairns + sun disc
;   Wickbarrow — wooden totem posts + sprouting branch
;   Sundust — narrow sandstone obelisks + scorched glyph (below)
; Tall narrow rectangles read as "ancient markers carved by erosion"
; — a fourth visual vocabulary players can identify at a glance.
[node name="ObeliskN" type="ColorRect" parent="." unique_id=1400000004]
offset_left = -14.0
offset_top = -210.0
offset_right = 14.0
offset_bottom = -110.0
