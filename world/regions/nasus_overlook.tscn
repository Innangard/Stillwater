; The east and west exits used to bounce the player directly to the
; Eastreach Altar and Westmoor Altar respectively — skipping the
; eastreach + west chains entirely, which broke progression. They've
; been removed; the player now reaches those altars only by traversing
; the proper chains (east chain through Wickbarrow, then sundust through
; Sprekken approach; west chain leaving Nasus city to the west). The
; only valid exits from this scene are the south back-portal (to
; Northwall Watch) and the north into Nasus city itself.

; The Nasus exit is currently a placeholder — the city scene doesn't
; exist yet. When you build it, point this here.
[node name="ExitNasus" parent="." instance=ExtResource("exit_scene")]
position = Vector2(0, -420)
target_scene = "res://world/regions/nasus_city.tscn"
target_spawn_point = "from_overlook"
label = "  enter Nasus"
tint = Color(0.55, 0.50, 0.46, 0.5)
zone_size = Vector2(192, 32)
