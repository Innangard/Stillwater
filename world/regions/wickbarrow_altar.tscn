player_scene = ExtResource("player_scene")

; Forest-shrine palette — deep green ground matches the east_path
; pool. The third altar in the game uses a third visual identity:
; Westmoor = cool slate, Eastreach = warm chalk, Wickbarrow = deep
; verdant forest. Player can tell which altar they're at instantly.
[node name="Background" type="ColorRect" parent="." unique_id=1300000002]
offset_left = -2000.0
offset_top = -2000.0
offset_right = 2000.0
offset_bottom = 2000.0
mouse_filter = 2
color = Color(0.22, 0.32, 0.22, 1)

