offset_top = -240.0
offset_right = 300.0
offset_bottom = 240.0
mouse_filter = 2
color = Color(0.40, 0.46, 0.32, 1)

; Four wooden totem posts at the cardinal points — different
; silhouette from Westmoor's standing stones (square slabs) and
; Eastreach's cairns (rounded stacks). Reads as a woodland shrine
; carved by hand.
