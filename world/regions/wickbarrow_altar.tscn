[node name="Player" parent="." unique_id=1300000025 instance=ExtResource("player_scene")]
position = Vector2(0, 240)

; Guardian pair — a melee goblin sword and a ranged skeleton burst.
; Tougher fight than either of the other two altars to compensate
; for the east chain being the shortest unlocked path to a capstone
; reward (no Nasus prerequisite, unlike the Westmoor / Eastreach
; altars).
[node name="GuardianGoblin" parent="." unique_id=1300000026 instance=ExtResource("enemy_b")]
position = Vector2(-150, -100)

[node name="GuardianSkeleton" parent="." unique_id=1300000027 instance=ExtResource("enemy_a")]
position = Vector2(160, -90)

; Capstone loot. living_wood_tablet is reserved for this altar (the
; "growing" sister to Westmoor's living_fire and Eastreach's
; deep_gold). Briar Fang is the signature weapon — venomous,
; thematically tied to the forest setting.
[node name="LivingWoodTabletPickup" parent="." unique_id=1300000028 instance=ExtResource("pickup_scene")]
position = Vector2(0, 100)
item = ExtResource("loot_capstone")
persistent_per_run = true

