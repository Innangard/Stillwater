[node name="DeepDesertDungeon" type="Node2D" unique_id=2300000001]
script = ExtResource("region_script")
region_id = "deep_desert_dungeon"
player_scene = ExtResource("player_scene")

; Deep Desert Dungeon — placeholder arena. EMPTY by design: the user
; intends to fill this with an optional boss encounter once the design
; lands. Until then, this scene exists so the dungeon entrance has a
; functional destination instead of a dead-end door.
;
; The arena is intentionally oversized (1280×960 — larger than any
; other room in the game) so future boss content has plenty of space
; for telegraphs, projectile patterns, and arena hazards. The empty
; floor is uniform dark sandstone — no decor — to signal "this is
; staged but not finished." When the boss design ships, replace the
; bare floor with proper arena dressing.
;
; Future hooks (commented placeholders below): a center marker where
; the boss spawns, corner markers for projectile-spawn arcs, an arena
; collision boundary that's tighter than the room boundary (boss
; fights look better in a ring than in a rectangle).

[node name="Background" type="ColorRect" parent="." unique_id=2300000002]
offset_left = -2000.0
offset_top = -2000.0
offset_right = 2000.0
offset_bottom = 2000.0
mouse_filter = 2
color = Color(0.18, 0.14, 0.10, 1)

; Arena floor — large dark sandstone slab. The dimmer tone vs the
; corridor outside marks "you're inside now, the rules are different."
[node name="ArenaFloor" type="ColorRect" parent="." unique_id=2300000003]
offset_left = -640.0
offset_top = -480.0
offset_right = 640.0
offset_bottom = 480.0
mouse_filter = 2
color = Color(0.26, 0.20, 0.14, 1)

; Center marker for future boss-spawn alignment. Visually a slightly
; darker square in the middle of the floor — a player visiting the
; empty arena will see "something is supposed to go here," which is
; the intended read for a placeholder.
[node name="CenterMark" type="ColorRect" parent="." unique_id=2300000010]
offset_left = -40.0
offset_top = -40.0
offset_right = 40.0
offset_bottom = 40.0
mouse_filter = 2
color = Color(0.12, 0.08, 0.05, 1)

