; Smith Mooren stocks the storm-themed forge recipes — they fit the
; moor's electrical/cold weather identity. Same recipes as Orn in
; Nasus to keep the upgrade paths consistent across the two cities;
; the player can craft these here if they couldn't earlier.
[ext_resource type="Resource" path="res://crafting/instances/forge_stormhammer.tres" id="recipe_shammer"]
[ext_resource type="Resource" path="res://crafting/instances/forge_thunderstrike.tres" id="recipe_tstrike"]
[ext_resource type="Resource" path="res://crafting/instances/forge_sparkblade.tres" id="recipe_spark"]
[ext_resource type="Resource" path="res://crafting/instances/forge_voltbow.tres" id="recipe_voltbow"]

; Merchant Eska sells the staple reagents. Wickbarrow + Nasus already
; cover the basics; Eska's stock leans on items that map to enemies
; the player encounters in the moors and on the way here.
[ext_resource type="Resource" path="res://crafting/instances/buy_soul_phial.tres" id="buy_phial"]
[ext_resource type="Resource" path="res://crafting/instances/buy_pale_ash.tres" id="buy_ash"]
[ext_resource type="Resource" path="res://crafting/instances/buy_frost_filament.tres" id="buy_frost"]
[ext_resource type="Resource" path="res://crafting/instances/buy_hollow_bone.tres" id="buy_hbone"]
[ext_resource type="Resource" path="res://crafting/instances/buy_bog_bile.tres" id="buy_bile"]

; Norn Kettil inscribes the rune set. Smaller selection than Svala
; in Nasus (Kettil is the apprentice's apprentice's apprentice) but
; covers the moor-themed runes — storm, frost, defensive.
[ext_resource type="Resource" path="res://crafting/instances/runes/rune_isa_runebone.tres" id="rune_isa"]
[ext_resource type="Resource" path="res://crafting/instances/runes/rune_hagalaz_runebone.tres" id="rune_hagalaz"]
[ext_resource type="Resource" path="res://crafting/instances/runes/rune_nauthiz_runebone.tres" id="rune_nauthiz"]
[ext_resource type="Resource" path="res://crafting/instances/runes/rune_algiz_runebone.tres" id="rune_algiz"]

; Building collision rectangles. The town is laid out as a plaza
; surrounded by four cardinal building footprints — same general
; pattern as Nasus City but slightly larger.
[sub_resource type="RectangleShape2D" id="bldg_forge"]
