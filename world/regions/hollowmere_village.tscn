[node name="Player" parent="." unique_id=3000000090 instance=ExtResource("player_scene")]
position = Vector2(580, 0)

; === NAMED NPCs ===

; Smith Mooren — blacksmith, just outside the forge entrance.
; Carries the same storm-themed recipes Orn does in Nasus; this is
; the alternative crafting site for players who come through the
; moor route rather than backtracking to Nasus.
[node name="SmithMooren" parent="." unique_id=3000000100 instance=ExtResource("npc_scene")]
position = Vector2(-340, -130)
npc_name = "Smith Mooren"
sprite_name = "npc_mooren"
dialogue = ExtResource("dlg_mooren")
tint = Color(0.45, 0.35, 0.30, 1)
station_name = "Mooren's Forge"
recipes = Array[Resource]([ExtResource("recipe_shammer"), ExtResource("recipe_tstrike"), ExtResource("recipe_spark"), ExtResource("recipe_voltbow")])

; Merchant Eska — under the stall awning in the NE.
[node name="MerchantEska" parent="." unique_id=3000000101 instance=ExtResource("npc_scene")]
position = Vector2(350, -140)
npc_name = "Merchant Eska"
sprite_name = "npc_eska"
dialogue = ExtResource("dlg_eska")
tint = Color(0.50, 0.45, 0.38, 1)
station_name = "Eska's Wares"
recipes = Array[Resource]([ExtResource("buy_phial"), ExtResource("buy_ash"), ExtResource("buy_frost"), ExtResource("buy_hbone"), ExtResource("buy_bile")])

; Skald Othlin — on the hall's porch, southern side of the plaza.
; No crafting station; he's a lore figure who delivers Hollowmere's
; backstory across four lines of dialogue.
[node name="SkaldOthlin" parent="." unique_id=3000000102 instance=ExtResource("npc_scene")]
position = Vector2(0, 140)
npc_name = "Skald Othlin"
sprite_name = "npc_othlin"
dialogue = ExtResource("dlg_othlin")
tint = Color(0.40, 0.30, 0.45, 1)

; Norn Kettil — at the eastern end of the plaza, beside the standing
; stone. Smaller rune selection than Svala in Nasus (4 vs 8) since
; Kettil is a lesser-known practitioner; the moor's rune tradition
; is documented but not central.
[node name="NornKettil" parent="." unique_id=3000000103 instance=ExtResource("npc_scene")]
position = Vector2(180, 60)
npc_name = "Norn Kettil"
sprite_name = "npc_kettil"
dialogue = ExtResource("dlg_kettil")
tint = Color(0.35, 0.40, 0.55, 1)
station_name = "Kettil's Inscriptions"
recipes = Array[Resource]([ExtResource("rune_isa"), ExtResource("rune_hagalaz"), ExtResource("rune_nauthiz"), ExtResource("rune_algiz")])

; Bath house — built-in interactable for smell reduction. Place it
; west of the plaza so players have a clear separation between the
; commercial (Eska, Mooren) and personal-services (Tova) sides.
[node name="BathHouse" parent="." unique_id=3000000104 instance=ExtResource("bath_scene")]
position = Vector2(-180, 90)

; Bathkeeper Tova — at the bath house. Standalone NPC; the bath_house
; itself handles the smell-reduction interaction, so Tova is here for
; flavor and a small dialogue scene without a crafting station.
[node name="BathkeeperTova" parent="." unique_id=3000000105 instance=ExtResource("npc_scene")]
position = Vector2(-180, 130)
npc_name = "Bathkeeper Tova"
sprite_name = "npc_tova"
dialogue = ExtResource("dlg_tova")
tint = Color(0.55, 0.55, 0.65, 1)

; Quest board — central, against the standing stone. Where future
; quests live; for now it's an interactable placeholder.
[node name="QuestBoard" parent="." unique_id=3000000110 instance=ExtResource("qb_scene")]
position = Vector2(80, -120)

; === ATMOSPHERE TOWNSPEOPLE ===
