size = Vector2(140, 90)

[sub_resource type="RectangleShape2D" id="bldg_house_e"]
size = Vector2(140, 90)

[node name="HollowmereVillage" type="Node2D" unique_id=3000000001]
script = ExtResource("region_script")
region_id = "hollowmere_village"
player_scene = ExtResource("player_scene")

; Slate / moor palette. Cooler and more weathered than Nasus, which
; reads as warm stone. The continuity from the Hollowmere corridor
; (which uses the same family) makes the arrival feel like "you've
; reached the heart of what you've been walking through," not a
; sudden change of scenery.
[node name="Background" type="ColorRect" parent="." unique_id=3000000002]
offset_left = -2000.0
offset_top = -2000.0
offset_right = 2000.0
offset_bottom = 2000.0
mouse_filter = 2
color = Color(0.24, 0.28, 0.32, 1)

; Central plaza — flagstones, lighter than the surrounding moor so
; it reads as "intentionally built, maintained, civilized."
[node name="Plaza" type="ColorRect" parent="." unique_id=3000000003]
