; === EXITS ===
; East exit — back into the moor corridor toward Westmoor Altar.
; The runtime _try_chain rewrites this to point at the last buffer
; of the hollowmere chain (which itself walks back to the altar);
; static fallback is the altar directly so the player isn't stranded
; if override logic fails.
[node name="ExitEast" parent="." instance=ExtResource("exit_scene")]
position = Vector2(620, 0)
target_scene = "res://world/regions/westmoor_altar.tscn"
target_spawn_point = "from_west"
label = "→  back into the moor"
tint = Color(0.30, 0.36, 0.42, 0.4)
zone_size = Vector2(48, 192)

; North exit — Hindarfjall path. Mountain-grey tint distinguishes the
; three new mountain exits from the moor-toned east exit. The target
; scene below is a static fallback; PathManager._try_chain rewrites
; it to the first buffer of the hindarfjall chain at runtime.
[node name="ExitNorth" parent="." instance=ExtResource("exit_scene")]
position = Vector2(0, -320)
target_scene = "res://world/regions/hindarfjall_altar.tscn"
target_spawn_point = "from_south"
label = "↑  straight up the spine"
tint = Color(0.50, 0.55, 0.60, 0.4)
zone_size = Vector2(192, 48)

; West exit — Hrimbjarg path (the chain routes NNW from here, ending
; at Hrimbjarg Altar, the frost-rock spur). Same tint as the north
; exit since they're both mountainous.
[node name="ExitWest" parent="." instance=ExtResource("exit_scene")]
position = Vector2(-620, 0)
target_scene = "res://world/regions/hrimbjarg_altar.tscn"
target_spawn_point = "from_east"
label = "←  the trail through the ridge"
tint = Color(0.50, 0.55, 0.60, 0.4)
zone_size = Vector2(48, 192)

; South exit — Thursdal path. The narrative justification for a NW
; path exiting south is that the giants' valley is reached by a back
; track that runs around the village's south side before climbing
; into the western hills. Label hints at this layout so the player
; isn't confused by the southward gate leading to a NW destination.
[node name="ExitSouth" parent="." instance=ExtResource("exit_scene")]
position = Vector2(0, 320)
target_scene = "res://world/regions/thursdal_altar.tscn"
target_spawn_point = "from_north"
label = "↓  the back track to the valley"
tint = Color(0.50, 0.55, 0.60, 0.4)
zone_size = Vector2(192, 48)
