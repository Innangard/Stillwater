; Spawn markers — player arrives from the east (the corridor back to
; Westmoor Altar). Default + from_east put them at the east entrance.
; Three new mountain-side spawn markers added for the act 2 chains:
;   from_north — Hindarfjall path (straight north)
;   from_west  — Hrimbjarg path (NNW, slightly west)
;   from_south — Thursdal path (NW, the back track around the village)
[node name="default" type="Marker2D" parent="." unique_id=3000000080]
position = Vector2(580, 0)

[node name="from_east" type="Marker2D" parent="." unique_id=3000000081]
position = Vector2(580, 0)

[node name="from_north" type="Marker2D" parent="." unique_id=3000000082]
