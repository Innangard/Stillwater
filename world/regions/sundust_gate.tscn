; ExitWest is STATIC — leads back to the Eastreach Altar. No
; apply_overrides logic touches this exit (the gate is not the start
; or end of any chain heading west). Hardcoded for life.
[node name="ExitWest" parent="." instance=ExtResource("exit_scene")]
position = Vector2(-420, 0)
target_scene = "res://world/regions/eastreach_altar.tscn"
target_spawn_point = "from_east"
label = "←  back to the altar"
tint = Color(0.55, 0.50, 0.40, 0.4)
zone_size = Vector2(48, 192)

; ExitEast — STATIC FALLBACK points back at the altar for safety,
; but apply_overrides REWRITES this exit at runtime: the gate is the
; SUNDUST_CHAIN_START_SCENE, so _try_chain rewires ExitEast to the
; first random sundust buffer (with the right spawn marker) the
; moment the player enters this room. The fallback target only
; matters in the unlikely event apply_overrides fails to run — in
; that case the player isn't stranded.
[node name="ExitEast" parent="." instance=ExtResource("exit_scene")]
position = Vector2(420, 0)
target_scene = "res://world/regions/eastreach_altar.tscn"
target_spawn_point = "default"
label = "→  into the desert"
tint = Color(0.78, 0.60, 0.32, 0.4)
zone_size = Vector2(48, 192)

; SANDWORM BROODMOTHER — mini-boss gatekeeper. Positioned east of
; the threshold stone so a player entering from the altar (west)
; reads the room in this order: threshold marker → broodmother mound
; → eastern desert exit. She starts burrowed (the SandWorm parent's
; _ready snaps to that state), so on first sight she's a large dark
; mound in the room's far third — easy to spot, communicates "this
; is not just decor."
;
; Engagement geometry: base_detection = 500 covers the full room
; width (gate is 880 wide), so she'll detect the player the moment
; they enter. Her erupt range (~364 reach) and spit range (~320)
; reach most of the room, so the player can't just stand at one
; wall and shoot her — they have to enter her territory.
;
; She respawns every time the gate scene is instanced — same as
; any normal enemy in any normal room. For "kill once per run" or
; "kill once permanently" behavior, gate the spawn at scene load
; via RunState.consumed_node_paths (per-run) or
; GameState.is_boss_dead("sandworm_broodmother") (permanent). The
; broodmother.gd doesn't currently call mark_boss_dead on death;
; wire that into _on_died if persistent kill tracking is wanted.
[node name="SandwormBroodmother" parent="." instance=ExtResource("broodmother_scene")]
position = Vector2(140, 0)
