[node name="SundustGate" type="Node2D" unique_id=1500000001]
script = ExtResource("region_script")
region_id = "sundust_gate"
player_scene = ExtResource("player_scene")

; SUNDUST GATE — the static threshold between the Eastreach Altar
; and the randomized desert spine. Same room every seed, intentionally
; corridor-shaped (wider east-west than north-south) so the player
; reads it as a passage rather than a destination. No N or S exits;
; the player walks west to return to the altar, east to enter the
; random sundust chain.
;
; Palette matches Eastreach + Sundust (warm sand BG, lighter sand
; path) — the visual continuity tells the player "still the same
; biome", with the architecture (gate arch + pillars) doing the work
; of marking "this is a threshold".
;
; No enemies, no pickups. Future hooks: this is a natural location
; for a gatekeeper NPC, a lore inscription, a tutorial beat for the
; desert region, or a shopkeeper. Static-room status makes any of
; those persistent across runs without needing to randomize them.

[node name="Background" type="ColorRect" parent="." unique_id=1500000002]
offset_left = -2000.0
offset_top = -2000.0
offset_right = 2000.0
offset_bottom = 2000.0
mouse_filter = 2
color = Color(0.55, 0.50, 0.40, 1)

; Central east-west path: the corridor floor that connects the two
; exits visually. Slightly wider than typical chain tracks to give the
; gate the feel of a maintained processional way (vs the chain's
; "you're hiking a worn trail" tone).
